---
const links = [
  { href: '#about', text: 'About' },
  { href: '#projects', text: 'Projects' },
  { href: '#speaking', text: 'Speaking' },
  { href: '#contact', text: 'Contact' },
]
---

<nav
  class="fixed top-0 right-0 left-0 z-50 bg-white shadow-md"
>
  <div
    class="container mx-auto flex max-w-screen-lg items-center justify-between p-4"
  >
    <a
      href="/"
      class="text-primary hidden text-xl font-bold md:block"
      >Keeghan McGarry</a
    >
    <ul class="mx-auto flex gap-2 md:mx-0 md:gap-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="hover:text-primary"
            >
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
