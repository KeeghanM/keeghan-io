---
import { ArrowDown } from 'lucide-react'
import { Button } from '@/components/ui/button'
import { Image } from 'astro:assets'

import keeghanImage from '@/images/keeghan.jpg'
---

<section
  id="hero"
  class="relative flex min-h-screen items-center"
>
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-100 to-purple-200"
  >
  </div>

  <div class="section-container">
    <div class="grid items-center gap-12 md:grid-cols-2">
      <div
        class="animate-fade-in order-2 md:order-1"
        style={{ animationDelay: '0.2s' }}
      >
        <h1
          class="mb-4 text-4xl font-bold tracking-tight md:text-5xl lg:text-6xl"
        >
          Hi, I'm <span class="text-primary"
            >Keeghan McGarry</span
          >
        </h1>
        <p class="mb-8 max-w-lg text-xl text-gray-700">
          I'm a tech leader currently working as the Head of
          Web Development at Vertu Motors, with almost two
          decades of programming experience — I connect
          strategy, architecture, people leadership, and
          technical expertise.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="#projects">
            <Button>See My Work</Button></a
          >
          <a href="#contact">
            <Button variant="secondary">
              Get In Touch
            </Button>
          </a>
        </div>
      </div>

      <div
        class="animate-fade-in order-1 flex justify-center md:order-2 md:justify-end"
        style={{ animationDelay: '0.4s' }}
      >
        <div
          class="relative h-72 w-72 overflow-hidden rounded-full border-4 border-white shadow-xl md:h-96 md:w-96"
        >
          <div
            class="absolute inset-0 flex items-center justify-center bg-orange-300/20 text-gray-500"
          >
            <Image
              class="mt-[25%]"
              src={keeghanImage}
              alt="Keeghan McGarry"
            />
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute bottom-8 left-1/2 -translate-x-1/2 transform animate-bounce"
    >
      <a
        href="#about"
        class="hover:text-primary text-gray-500 transition-colors"
      >
        <ArrowDown size={32} />
      </a>
    </div>
  </div>
</section>
