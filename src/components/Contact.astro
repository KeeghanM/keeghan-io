---
import { Github, Linkedin } from 'lucide-react'
import ContactForm from './ContactForm'
---

<div class="section-container">
  <h2 class="section-title">Get In Touch</h2>

  <div class="grid gap-12 md:grid-cols-2">
    <div>
      <p class="mb-8 text-lg text-gray-700">
        I'm always open to discussing new projects,
        opportunities or partnerships. Whether you have a
        question or just want to say hi, I'll do my best to
        get back to you!
      </p>

      <div class="space-y-6">
        <div class="flex items-center gap-4">
          <div class="rounded-full bg-orange-100 p-3">
            <Github
              size={24}
              className="text-primary"
            />
          </div>
          <div>
            <h3 class="text-lg font-medium">GitHub</h3>
            <a
              href="https://github.com/KeeghanM"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
            >
              github.com/KeeghanM
            </a>
          </div>
        </div>

        <div class="flex items-center gap-4">
          <div class="rounded-full bg-orange-100 p-3">
            <Linkedin
              size={24}
              className="text-primary"
            />
          </div>
          <div>
            <h3 class="text-lg font-medium">LinkedIn</h3>
            <a
              href="https://linkedin.com/in/keeghan-mcgarry"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary hover:underline"
            >
              linkedin.com/in/keeghan-mcgarry
            </a>
          </div>
        </div>
      </div>
    </div>
    <ContactForm client:visible />
  </div>
</div>
