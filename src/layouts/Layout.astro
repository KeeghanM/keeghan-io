---
export interface Props {
  title: string
}

const { title } = Astro.props

import '@/styles/global.css'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Keeghan McGarry's digital portfolio showcasing web development expertise, leadership, and projects."
    />
    <meta
      name="viewport"
      content="width=device-width"
    />
    <link
      rel="icon"
      href="/favicon.ico"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
